# Configuration for the two-box TP=2 SGLang cluster (Qwen3.8-27B NVFP4 + DFlash2) — THE EXAMPLE. Copy it to
# sglang-tp2.env (gitignored) next to it and fill in the deployment's own boxes: launch-pair.sh, teardown.sh and
# bench.sh source sglang-tp2.env and refuse to run without it; it is forwarded to sglang-rank on each box. The
# boxes, their fabric addresses, the client address and the interface have NO default.
# A value already in the environment WINS over the one here (`: "${X:=…}"`), so a one-off is
#   SGLANG_SEATS=4 deploy/sglang-27b-tp2/launch-pair.sh
# and nothing in this file has to be edited for an experiment.

# ── the two boxes ────────────────────────────────────────────────────────────
# Rank 0 serves the HTTP API and is the rendezvous; rank 1 is headless.
# The head holds the checkpoints on its own NVMe, so it is rank 0: its weight reads are local. The hosts are ssh
# names (e.g. box-a, box-b); the IPs are each box's address on the pair's fabric link (e.g. 192.0.2.201/30 and
# 192.0.2.202/30: `ip -4 -o addr show <iface>`).
: "${SGLANG_RANK0_HOST:?SGLANG_RANK0_HOST is not set — rank 0, the head (copy sglang-tp2.example.env to sglang-tp2.env)}"
: "${SGLANG_RANK1_HOST:?SGLANG_RANK1_HOST is not set — rank 1, headless}"
: "${SGLANG_RANK0_IP:?SGLANG_RANK0_IP is not set — rank 0 address on the fabric link}"
: "${SGLANG_RANK1_IP:?SGLANG_RANK1_IP is not set — rank 1 address on the fabric link}"
: "${SGLANG_DIST_ADDR:=$SGLANG_RANK0_IP}"

# The address CLIENTS use, which is NOT the fabric address. SGLANG_RANK0_IP is the head's address on a
# point-to-point link between the two GB10 boxes that the LB's box has no route to, so a health poll or a
# benchmark aimed at it times out while the engine is up and serving. Measured 2026-10-02: the first good boot
# reached "The server is fired up and ready to roll!" and the launch script still declared failure 600 s later,
# purely because it was polling the fabric address. The head's address on the link the LB's box reaches it over
# is what answers, and it is the one vllm-lb uses too.
: "${SGLANG_API_HOST:?SGLANG_API_HOST is not set — the head address as the LB box reaches it}"

# ── ports (ours alone; vllm-lb's cluster owns 8100 and 25000) ────────────────
: "${SGLANG_PORT:=8020}"                 # the OpenAI-compatible API, on rank 0
: "${SGLANG_DIST_PORT:=50051}"           # the torch.distributed rendezvous

# ── the engine ──────────────────────────────────────────────────────────────
: "${SGLANG_SEATS:=8}"                   # --max-running-requests. 8 is this work's thermal ceiling:
                                         # the dense 27B at 16 seats uncapped hard-killed box-a in
                                         # 7 minutes on 2026-10-02. Upstream's dual recipe says 16.
: "${SGLANG_CONTEXT:=262144}"            # the hard top: DFlash2 is not YaRN-compatible on this build
: "${SGLANG_TARGET:=Qwen3.8-27B-NVFP4}"  # dir under the models root — OUR staged NVIDIA export
: "${SGLANG_DRAFT=Qwen3.8-27B-DFlash2}" # dir under the models root; empty = no speculative decoding
: "${SGLANG_SERVED_NAME:=qwen38-27b-sglang-tp2}"
# 0.80, NOT the forum thread's 0.90 — measured on OUR boxes 2026-10-02. At 0.90 with DFlash2 the
# engine sized a 4,029,069-token KV pool: 61.5 GB of target KV (K 30.74 + V 30.74) PLUS 19.2 GB of
# draft KV (9.61 + 9.61), leaving rank 1 with 12.11 GB. Rank 1 then died during FlashInfer autotune
# with no traceback at all (only "leaked semaphore ... at shutdown"), i.e. killed from outside, and
# rank 0 followed with gloo "Connection closed by peer [192.0.2.202]". 0.80 is also what the SGLang
# cookbook pins for GB10, upstream noting 0.85 trips DGX OS earlyoom.
: "${SGLANG_MEM_FRACTION:=0.80}"
: "${SGLANG_DRAFT_TOKENS:=8}"
# 5, not 4: the engine itself said so on the first launch —
#   "max_running_requests is capped to 6 by the mamba state cache
#    (max_mamba_cache_size=32, 5 state slots per request)"
# DFlash2 holds five GDN state slots per running request, so upstream's "concurrency x S" with S=4
# silently caps the seats below what was asked for. 8 seats therefore needs 40.
: "${SGLANG_MAMBA_SLOTS_PER_REQ:=5}"

# ── the fabric ──────────────────────────────────────────────────────────────
# The interface NCCL's socket layer binds on each box: the fabric link itself (e.g. bond0 for an 802.3ad bond of
# the two 200 GbE ports at MTU 9000, whose RoCE devices then report active_mtu 4096 — the value lb/cluster/tp-rank
# runs with). Not a port that is outside the bond: its RoCE device runs MTU 1500 (active_mtu 1024).
: "${SGLANG_IFACE:?SGLANG_IFACE is not set — the fabric link interface on each box, e.g. bond0}"
# Empty = NCCL enumerates /sys/class/infiniband itself, exactly as the working vLLM TP=2 pair does. If NCCL hangs
# at warmup, the value to try is the bond's own two RoCE devices (`ls /sys/class/infiniband`), comma-separated.
: "${SGLANG_NCCL_IB_HCA:=}"

# ── the image ───────────────────────────────────────────────────────────────
# linux/arm64, the pin upstream's own start-dflash.sh carries at HEAD. Contains sglang #35371
# (DFlash2), #35496 (quantized target lm_head in the DFlash2 selector), #34763, #35255.
: "${SGLANG_IMAGE:=lmsysorg/sglang@sha256:00205b89f74691f76a0ffbd6846376d9323971930a5d59bf63a65dadc7d67927}"

# ── timings ─────────────────────────────────────────────────────────────────
: "${SGLANG_READY_TIMEOUT_S:=1800}"      # whole boot budget; weights + CUDA graphs + draft capture
: "${SGLANG_QUIET_ABORT_S:=600}"         # no new log line on rank 0 for this long = give up and HALT
: "${SGLANG_CPUSET:=5-9,15-19}"          # GB10's ten 3.9 GHz Cortex-X5 cores; empty = no pinning

# Free-form extra SGLang flags, appended LAST (argparse last-wins). Used by the no-speculation
# arm to keep --mamba-radix-cache-strategy extra_buffer pinned even with no drafter configured.
: "${SGLANG_EXTRA_ARGS:=}"

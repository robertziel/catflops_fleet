# Rendered by deploy/standalone/install-node-applier.sh, one per cluster. Runs cluster @CLUSTER@'s applier the moment
# the LB writes its intent (an atomic rename into this name counts). An intent written while a pass runs is picked up
# by the next heartbeat.
[Unit]
Description=vLLM node applier for cluster @CLUSTER@: run when the LB writes an intent

[Path]
PathChanged=@NODE_DIR@/intent.json
Unit=vllm-node-applier-@CLUSTER@.service

[Install]
WantedBy=default.target

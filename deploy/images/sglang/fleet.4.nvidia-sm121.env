# SGLang build fleet.4 on nvidia-sm121 (GB10): the pin deploy/images/build.sh reads — KEY=VALUE, one a line, never
# sourced. PLATFORM, TARGET and BASE_ID are the build's own; every other key is a --build-arg of ./Dockerfile.
#
# The Dockerfile RUNs (git apply, the build gate's pytest), so build it ON an arm64 box: `remote <box> [<box> ...]`
# builds once on the first and copies it to the rest by id (deploy/sglang-27b-tp2/image/build.sh does, on BOXES).
PLATFORM=linux/arm64
# The GB10 arm64 build of upstream SGLang 708f51e44bc6, pinned by digest.
BASE=lmsysorg/sglang@sha256:00205b89f74691f76a0ffbd6846376d9323971930a5d59bf63a65dadc7d67927
# Every fix the build carries, in the order applied (each made against the tree the ones before it leave; the
# Dockerfile says what each fixes). fleet.4 = fleet.3 + qsa-fp8-kv.
PATCHES=anthropic-tool-order qwen3-coder-truncated-call anthropic-thinking-display qwen4-exp-mtp-quantized anthropic-effort-xhigh qsa-fp8-kv

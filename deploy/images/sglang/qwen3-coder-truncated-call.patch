+    def _streams_as_string(self, param_name: str, tools: Optional[list[Tool]]) -> bool:
+        """True when _convert_param_value would return this parameter's text as is."""
+        param_config = self._get_arguments_config(self.current_func_name, tools)
+        if param_name not in param_config:
+            return True
+        return self._get_param_type(param_config[param_name]) in [
+            "string", "str", "text", "varchar", "char", "enum"
+        ]
+
+    def _param_end(self, text: str) -> tuple[int, int]:
+        """(position, length) of the earliest marker that ends a parameter value, or (-1, 0).
+
+        Same rule as the whole-value path: `</parameter>` normally, and the next
+        `<parameter=` or `</function>` when the model left it out."""
+        found = [
+            (pos, length)
+            for pos, length in (
+                (text.find(self.parameter_end_token), len(self.parameter_end_token)),
+                (text.find(self.parameter_prefix), 0),
+                (text.find(self.function_end_token), 0),
+            )
+            if pos != -1
+        ]
+        return min(found) if found else (-1, 0)
+
+    def _held_marker_len(self, text: str) -> int:
+        """Length of the suffix of `text` that may still become a value's end marker."""
+        markers = (self.parameter_end_token, self.parameter_prefix, self.function_end_token)
+        for i in range(max(0, len(text) - max(map(len, markers)) + 1), len(text)):
+            if text[i] == "<" and any(m.startswith(text[i:]) for m in markers):
+                return len(text) - i
+        return 0
+
+    def _may_be_null(self, value_so_far: str) -> bool:
+        """Whether the value can still end as `null` (any case), which converts to JSON null."""
+        head, rest = value_so_far[:4], value_so_far[4:]
+        if not "null".startswith(head.lower()):
+            return False
+        if rest.startswith("\n"):
+            rest = rest[1:]
+        return not rest or any(
+            m.startswith(rest)
+            for m in (self.parameter_end_token, self.parameter_prefix, self.function_end_token)
+        )
+

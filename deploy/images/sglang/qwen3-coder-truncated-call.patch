+    def finish(self, tools: List[Tool]) -> StreamingParseResult:
+        """The stream is over: release what waited for a marker that can no longer arrive.
+
+        Outside a call that is plain text (a trailing "<" held as a possible tag
+        start). Inside one it is a call cut off mid-arguments (finish_reason
+        "length"): its name already went out, so emitting nothing would leave the
+        client the complete, valid call `{}`, which it runs. The arguments written
+        so far go out instead, as JSON that is never closed: the cut call can
+        never run as if it were whole.
+        """
+        rest = self._buffer[self.parsed_pos :]
+        self._buffer, self.parsed_pos = "", 0
+        if self.current_func_name is None and self.streaming_param is None:
+            if self.is_inside_tool_call:
+                return StreamingParseResult()
+            return StreamingParseResult(normal_text=rest)
+
+        calls = []
+        if self.streaming_param is not None:
+            param_name, value = self.streaming_param, rest
+            if not self.streaming_param_lead_done and value.startswith("\n"):
+                value = value[1:]
+        elif rest.startswith(self.parameter_prefix) and ">" in rest:
+            name_end = rest.index(">")
+            param_name, value = rest[len(self.parameter_prefix) : name_end], rest[name_end + 1 :]
+            if value.startswith("\n"):
+                value = value[1:]
+        else:
+            param_name = value = None
+
+        if param_name is not None and not (
+            self.streaming_param is not None and self.streaming_param_opened
+        ):
+            calls.extend(self._param_key_calls(param_name))
+            calls.append(ToolCallItem(tool_index=self.current_tool_id, parameters='"'))
+        elif not self.json_started:
+            calls.append(ToolCallItem(tool_index=self.current_tool_id, parameters="{"))
+            self.json_started = True
+        if value:
+            # The value written so far, as a JSON string never closed.
+            calls.append(
+                ToolCallItem(
+                    tool_index=self.current_tool_id,
+                    parameters=json.dumps(value, ensure_ascii=False)[1:-1],
+                )
+            )
+        self.streaming_param = None
+        self.current_func_name = None
+        return StreamingParseResult(calls=calls)
+
     def supports_structural_tag(self) -> bool:

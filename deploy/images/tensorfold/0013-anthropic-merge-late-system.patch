+    defer arena.deinit();
+    const out = try translatedMessages(arena.allocator(),
+        \\{"model": "m", "max_tokens": 8, "messages": [{"role": "user", "content": "hi"}, {"role": "system", "content": "r"}, {"role": "user", "content": "go"}]}
+    , "user");
+    try std.testing.expectEqual(@as(usize, 3), out.array.len);
+    try std.testing.expectEqualStrings("system", out.array[0].get("role").?.string);
+    try std.testing.expectEqualStrings("r", out.array[0].get("content").?.string);
+}
+
+test "a template without late system text still refuses turn-scoped system messages" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    try std.testing.expectError(error.Refused, translatedMessages(arena.allocator(),

+// Claude Code (beta mid-conversation-system-2026-04-07) sends its reminders as a trailing `role: system` message.
+const claude_code_turn =
+    \\{"model": "m", "max_tokens": 8, "system": [{"type": "text", "text": "S1"}, {"type": "text", "text": "S2"}],
+    \\ "messages": [{"role": "user", "content": "hi"}, {"role": "assistant", "content": "yo"}, {"role": "user", "content": "go"},
+    \\              {"role": "system", "content": [{"type": "text", "text": "  reminder  "}, {"type": "text", "text": " "}]}]}
+;

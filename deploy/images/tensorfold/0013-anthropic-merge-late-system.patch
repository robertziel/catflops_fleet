+}
+
+test "a template that renders late system text keeps it in place, unchanged" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const out = try translatedMessages(arena.allocator(), claude_code_turn, "system");
+    try std.testing.expectEqual(@as(usize, 5), out.array.len);
+    try std.testing.expectEqualStrings("S1\n\nS2", out.array[0].get("content").?.string);

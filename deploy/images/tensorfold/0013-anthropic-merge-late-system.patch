+test "a template without late system text: every system text merges into the leading system message, as SGLang's adapter does" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const out = try translatedMessages(arena.allocator(), claude_code_turn, "user");
+    try std.testing.expectEqual(@as(usize, 4), out.array.len);

diff --git a/zig/src/core/lanes/counting.zig b/zig/src/core/lanes/counting.zig
new file mode 100644
index 00000000..6b3fe383
--- /dev/null
+++ b/zig/src/core/lanes/counting.zig
@@ -0,0 +1,337 @@
+//! The work a backend did, counted where the round loop hands it over (fleet patch 0014): forward passes of each kind,
+//! the rows a decode pass verified and the context it attended to, the prompt tokens computed and restored, and the
+//! seconds the loop spent inside the backend. `Counting` wraps any backend and forwards every call unchanged; the
+//! HTTP threads read `work()` while the engine thread counts (atomics: no lock on the round's path).
+const std = @import("std");
+const be = @import("backend.zig");
+const Stream = @import("stream.zig").Stream;
+
+/// What /metrics publishes (server/metrics.zig). `prompt_passes`/`prompt_tokens` are the backend's own count of its
+/// prompt chunks (`backend.PromptWork`), null when it keeps none: a chunk is the backend's, not the loop's, to see.
+pub const Work = struct {
+    /// verify and one-token rounds: each is one forward of the target over every stream's window
+    decode_passes: u64 = 0,
+    /// rows those forwards verified (a stream's pending token and its drafts), summed over streams
+    verify_rows: u64 = 0,
+    /// the last decode pass: its streams, the rows it verified and the context tokens they attend to (summed)
+    last_streams: u64 = 0,
+    last_rows: u64 = 0,
+    last_context: u64 = 0,
+    /// prompt chunks run (each a full forward over its rows) and the prompt tokens they computed
+    prompt_passes: ?u64 = null,
+    prompt_tokens: ?u64 = null,
+    /// prompt tokens restored from kept states instead of computed (each stream's `cached` at its prompt pass)
+    cached_tokens: u64 = 0,
+    /// wall seconds the round loop spent inside the backend's calls (the GPU's work and the host's around it)
+    busy_seconds: f64 = 0,
+};
+
+const A = std.atomic.Value(u64);
+
+pub const Counting = struct {
+    inner: be.Backend,
+    vtable: be.Backend.VTable = undefined,
+    decode_passes: A = .init(0),
+    verify_rows: A = .init(0),
+    last_streams: A = .init(0),
+    last_rows: A = .init(0),
+    last_context: A = .init(0),
+    prompt_passes: A = .init(0),
+    prompt_tokens: A = .init(0),
+    cached_tokens: A = .init(0),
+    busy_ns: A = .init(0),
+
+    pub fn init(inner: be.Backend) Counting {
+        return .{ .inner = inner };
+    }
+
+    /// The counts so far, safe from any thread.
+    pub fn work(c: *const Counting) Work {
+        const known = c.inner.vtable.prompt_work != null;
+        return .{
+            .decode_passes = c.decode_passes.load(.monotonic),
+            .verify_rows = c.verify_rows.load(.monotonic),
+            .last_streams = c.last_streams.load(.monotonic),
+            .last_rows = c.last_rows.load(.monotonic),
+            .last_context = c.last_context.load(.monotonic),
+            .prompt_passes = if (known) c.prompt_passes.load(.monotonic) else null,
+            .prompt_tokens = if (known) c.prompt_tokens.load(.monotonic) else null,
+            .cached_tokens = c.cached_tokens.load(.monotonic),
+            .busy_seconds = @as(f64, @floatFromInt(c.busy_ns.load(.monotonic))) / 1e9,
+        };
+    }
+
+    /// The wrapped backend: every call forwarded as is, the optional ones only where the inner one has them.
+    pub fn backend(c: *Counting) be.Backend {
+        const v = c.inner.vtable;
+        c.vtable = .{
+            .prefill = prefill,
+            .first = first,
+            .queue = queue,
+            .read = read,
+            .verify = verify,
+            .keep = keep,
+            .draft = draft,
+            .unspeculate = if (v.unspeculate != null) unspeculate else null,
+            .probabilities = if (v.probabilities != null) probabilities else null,
+            .tree = if (v.tree != null) tree else null,
+            .alternatives = if (v.alternatives != null) alternatives else null,
+            .release = release,
+            .prefill_begin = if (v.prefill_begin != null) prefillBegin else null,
+            .prefill_step = if (v.prefill_step != null) prefillStep else null,
+            .prefill_many = if (v.prefill_many != null) prefillMany else null,
+            .prompt_work = v.prompt_work,
+        };
+        return .{ .ptr = c, .vtable = &c.vtable };
+    }
+
+    fn of(p: *anyopaque) *Counting {
+        return @ptrCast(@alignCast(p));
+    }
+
+    fn now() u64 {
+        var ts: std.c.timespec = undefined;
+        if (std.c.clock_gettime(.MONOTONIC, &ts) != 0) return 0;
+        return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+    }
+
+    fn since(c: *Counting, t0: u64) void {
+        const t1 = now();
+        if (t1 > t0 and t0 > 0) _ = c.busy_ns.fetchAdd(t1 - t0, .monotonic);
+    }
+
+    /// The backend's own prompt-chunk count, copied after each prompt call (on the engine thread, so never torn).
+    fn notePrompt(c: *Counting) void {
+        const pw = c.inner.vtable.prompt_work orelse return;
+        const w = pw(c.inner.ptr);
+        c.prompt_passes.store(w.passes, .monotonic);
+        c.prompt_tokens.store(w.tokens, .monotonic);
+    }
+
+    fn noteDecode(c: *Counting, streams: u64, rows: u64, context: u64) void {
+        _ = c.decode_passes.fetchAdd(1, .monotonic);
+        _ = c.verify_rows.fetchAdd(rows, .monotonic);
+        c.last_streams.store(streams, .monotonic);
+        c.last_rows.store(rows, .monotonic);
+        c.last_context.store(context, .monotonic);
+    }
+
+    fn prefill(p: *anyopaque, s: *Stream) anyerror!void {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        defer c.notePrompt();
+        try c.inner.vtable.prefill(c.inner.ptr, s);
+        _ = c.cached_tokens.fetchAdd(s.cached, .monotonic);
+    }
+
+    fn prefillBegin(p: *anyopaque, s: *Stream) anyerror!void {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        defer c.notePrompt();
+        try c.inner.vtable.prefill_begin.?(c.inner.ptr, s);
+        _ = c.cached_tokens.fetchAdd(s.cached, .monotonic);
+    }
+
+    fn prefillStep(p: *anyopaque, ss: []const *Stream, states: []be.FillState) anyerror!void {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        defer c.notePrompt();
+        return c.inner.vtable.prefill_step.?(c.inner.ptr, ss, states);
+    }
+
+    fn prefillMany(p: *anyopaque, ss: []const *Stream) anyerror!void {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        defer c.notePrompt();
+        try c.inner.vtable.prefill_many.?(c.inner.ptr, ss);
+        for (ss) |s| _ = c.cached_tokens.fetchAdd(s.cached, .monotonic);
+    }
+
+    fn first(p: *anyopaque, s: *Stream, position: u64) anyerror!u64 {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        return c.inner.vtable.first(c.inner.ptr, s, position);
+    }
+
+    /// A one-token round: one row for this stream, attending to its cache.
+    fn queue(p: *anyopaque, s: *Stream, feed: be.Feed, position: u64) anyerror!u64 {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        const h = try c.inner.vtable.queue(c.inner.ptr, s, feed, position);
+        c.noteDecode(1, 1, s.cache_len);
+        return h;
+    }
+
+    fn read(p: *anyopaque, handle: u64) anyerror!u32 {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        return c.inner.vtable.read(c.inner.ptr, handle);
+    }
+
+    /// One forward over every window: the decode pass.
+    fn verify(p: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        try c.inner.vtable.verify(c.inner.ptr, windows, out);
+        var rows: u64 = 0;
+        var context: u64 = 0;
+        for (windows) |w| {
+            rows += w.rows();
+            context += w.stream.cache_len;
+        }
+        c.noteDecode(windows.len, rows, context);
+    }
+
+    fn keep(p: *anyopaque, windows: []const be.Window, paths: []const []const u32) anyerror!void {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        return c.inner.vtable.keep(c.inner.ptr, windows, paths);
+    }
+
+    fn draft(p: *anyopaque, requests: []const be.DraftRequest) anyerror!void {
+        const c = of(p);
+        const t0 = now();
+        defer c.since(t0);
+        return c.inner.vtable.draft(c.inner.ptr, requests);
+    }
+
+    fn unspeculate(p: *anyopaque, s: *Stream) anyerror!void {
+        const c = of(p);
+        return c.inner.vtable.unspeculate.?(c.inner.ptr, s);
+    }
+
+    fn release(p: *anyopaque, s: *Stream) void {
+        const c = of(p);
+        c.inner.vtable.release(c.inner.ptr, s);
+    }
+
+    fn probabilities(p: *anyopaque, s: *Stream, out: []f64) anyerror!bool {
+        const c = of(p);
+        return c.inner.vtable.probabilities.?(c.inner.ptr, s, out);
+    }
+
+    fn tree(p: *anyopaque, s: *Stream, gpa: std.mem.Allocator) anyerror!?@import("stream.zig").Held {
+        const c = of(p);
+        return c.inner.vtable.tree.?(c.inner.ptr, s, gpa);
+    }
+
+    fn alternatives(p: *anyopaque, s: *Stream, out: []be.Alternative) anyerror!usize {
+        const c = of(p);
+        return c.inner.vtable.alternatives.?(c.inner.ptr, s, out);
+    }
+};
+
+/// A backend that only records what reached it, with a prompt-chunk count of its own.
+const Stub = struct {
+    verified: usize = 0,
+    prompt: be.PromptWork = .{},
+    with_prompt_work: bool = true,
+
+    fn of(p: *anyopaque) *Stub {
+        return @ptrCast(@alignCast(p));
+    }
+    fn prefill(p: *anyopaque, s: *Stream) anyerror!void {
+        const st = of(p);
+        s.cached = 2;
+        st.prompt.passes += 2;
+        st.prompt.tokens += s.prompt_len - 2;
+    }
+    fn first(_: *anyopaque, _: *Stream, _: u64) anyerror!u64 {
+        return 0;
+    }
+    fn queue(_: *anyopaque, _: *Stream, _: be.Feed, _: u64) anyerror!u64 {
+        return 1;
+    }
+    fn read(_: *anyopaque, _: u64) anyerror!u32 {
+        return 7;
+    }
+    fn verify(p: *anyopaque, _: []const be.Window, _: []be.Verified) anyerror!void {
+        of(p).verified += 1;
+    }
+    fn keep(_: *anyopaque, _: []const be.Window, _: []const []const u32) anyerror!void {}
+    fn draft(_: *anyopaque, _: []const be.DraftRequest) anyerror!void {}
+    fn release(_: *anyopaque, _: *Stream) void {}
+    fn promptWork(p: *anyopaque) be.PromptWork {
+        return of(p).prompt;
+    }
+    const with_vt: be.Backend.VTable = .{ .prefill = prefill, .first = first, .queue = queue, .read = read, .verify = verify, .keep = keep, .draft = draft, .release = release, .prompt_work = promptWork };
+    const without_vt: be.Backend.VTable = .{ .prefill = prefill, .first = first, .queue = queue, .read = read, .verify = verify, .keep = keep, .draft = draft, .release = release };
+    fn backend(st: *Stub) be.Backend {
+        return .{ .ptr = st, .vtable = if (st.with_prompt_work) &with_vt else &without_vt };
+    }
+};
+
+test "counting forwards every call and counts passes, rows, context and prompt work" {
+    const gpa = std.testing.allocator;
+    var stub: Stub = .{};
+    var c = Counting.init(stub.backend());
+    const b = c.backend();
+    var s = try Stream.init(gpa, .{ .id = "a", .prompt = &.{ 1, 2, 3, 4, 5, 6 }, .max_new = 4 });
+    defer s.deinit(gpa);
+    var t = try Stream.init(gpa, .{ .id = "b", .prompt = &.{ 1, 2, 3 }, .max_new = 4 });
+    defer t.deinit(gpa);
+    try b.prefill(&s);
+    try std.testing.expectEqual(@as(u32, 2), s.cached);
+    s.cache_len = 6;
+    t.cache_len = 3;
+    const ws = [_]be.Window{
+        .{ .stream = &s, .pending = 0, .held = 2, .tokens = &.{}, .parents = null, .positions = &.{} },
+        .{ .stream = &t, .pending = 0, .held = 0, .tokens = &.{9}, .parents = null, .positions = &.{} },
+    };
+    var out: [2]be.Verified = undefined;
+    try b.verify(&ws, &out);
+    try std.testing.expectEqual(@as(usize, 1), stub.verified);
+    try std.testing.expectEqual(@as(u32, 7), try b.read(try b.queue(&t, .{ .value = 1 }, 3)));
+    const w = c.work();
+    try std.testing.expectEqual(@as(u64, 2), w.decode_passes); // the verify and the one-token round
+    try std.testing.expectEqual(@as(u64, 3 + 2 + 1), w.verify_rows);
+    try std.testing.expectEqual(@as(u64, 1), w.last_streams);
+    try std.testing.expectEqual(@as(u64, 1), w.last_rows);
+    try std.testing.expectEqual(@as(u64, 3), w.last_context);
+    try std.testing.expectEqual(@as(?u64, 2), w.prompt_passes);
+    try std.testing.expectEqual(@as(?u64, 4), w.prompt_tokens);
+    try std.testing.expectEqual(@as(u64, 2), w.cached_tokens);
+    try std.testing.expect(w.busy_seconds >= 0);
+}
+
+test "a verify's gauges are that pass's: streams, rows and summed context" {
+    const gpa = std.testing.allocator;
+    var stub: Stub = .{};
+    var c = Counting.init(stub.backend());
+    const b = c.backend();
+    var s = try Stream.init(gpa, .{ .id = "a", .prompt = &.{ 1, 2 }, .max_new = 4 });
+    defer s.deinit(gpa);
+    s.cache_len = 100;
+    var t = try Stream.init(gpa, .{ .id = "b", .prompt = &.{ 1, 2 }, .max_new = 4 });
+    defer t.deinit(gpa);
+    t.cache_len = 50;
+    const ws = [_]be.Window{
+        .{ .stream = &s, .pending = 0, .held = 3, .tokens = &.{}, .parents = null, .positions = &.{} },
+        .{ .stream = &t, .pending = 0, .held = 1, .tokens = &.{}, .parents = null, .positions = &.{} },
+    };
+    var out: [2]be.Verified = undefined;
+    try b.verify(&ws, &out);
+    const w = c.work();
+    try std.testing.expectEqual(@as(u64, 2), w.last_streams);
+    try std.testing.expectEqual(@as(u64, 4 + 2), w.last_rows);
+    try std.testing.expectEqual(@as(u64, 150), w.last_context);
+}
+
+test "a backend that counts no prompt chunks leaves them unknown, not zero" {
+    var stub: Stub = .{ .with_prompt_work = false };
+    var c = Counting.init(stub.backend());
+    const b = c.backend();
+    try std.testing.expect(b.vtable.prompt_work == null);
+    const w = c.work();
+    try std.testing.expectEqual(@as(?u64, null), w.prompt_passes);
+    try std.testing.expectEqual(@as(?u64, null), w.prompt_tokens);
+}

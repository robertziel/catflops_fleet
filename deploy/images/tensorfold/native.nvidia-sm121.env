# TensorFold build native on nvidia-sm121 (GB10): the pin deploy/images/build.sh reads — KEY=VALUE, one a line, never
# sourced. PLATFORM, TARGET and BASE_ID are the build's own; every other key is a --build-arg of ./Dockerfile.
#
# The Dockerfile RUNs (Zig, the gate, the build), so build it ON an arm64 box: `remote <build-box> [<box> ...]` builds
# once and copies it to the rest by id — two Zig builds of one tree are not byte-identical, and a TP pair must run the
# same bits on each rank (deploy/tensorfold/image/build.sh).
PLATFORM=linux/arm64
# The mia-ai recipe's published image (ghcr.io/miaai-lab/qwen3.8-flash-dual-dgx-sparks-tensorfold@sha256:e188128d…,
# tag zig-db28187-f3e1300f4f62), loaded on each box under this local name. It is not pulled by digest, so the build
# first holds every box's copy to BASE_ID, its config digest, and refuses a box whose image differs.
BASE=tensorfold-qwen38fn:zig-db28187-ghcr
BASE_ID=sha256:5eb5d4d384773543109baa26783fc6ea38ad619dff330f01672e05c01721cfb0
# The tree BASE's tensorfold-native was built from: TensorFold at TF_REF plus the recipe's patches at RECIPE_REF — the
# commit whose image_hash is BASE's tf.patches label, f3e1300f4f62 (recipe scripts/config.sh) — and its Zig, the
# tarball for this platform with its checksum.
TF_REPO=https://github.com/ashhart/TensorFold.git
TF_REF=db281878ddb836fd0df510d8771ecb7e0fe47d26
RECIPE_REPO=https://github.com/MiaAI-Lab/Qwen3.8-Flash-Dual-DGX-Sparks-TensorFold.git
RECIPE_REF=be3ed857ab1055ca47b36134d22691f00f2bb94a
ZIG_VERSION=0.17.0
ZIG_PLATFORM=aarch64-linux
ZIG_SHA256=9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8
# The fleet's patches over the recipe's, recorded on the image as its tf.fleet.patches label (the Dockerfile applies
# every *.patch in this directory, in name order).
FLEET_PATCHES=0013-anthropic-merge-late-system.patch 0014-work-counters.patch

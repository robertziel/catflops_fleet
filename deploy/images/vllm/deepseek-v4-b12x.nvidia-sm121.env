# vLLM build deepseek-v4-b12x on nvidia-sm121 (GB10): the pin deploy/images/build.sh reads — KEY=VALUE, one a line,
# never sourced. PLATFORM, TARGET and BASE_ID are the build's own; every other key is a --build-arg of ./Dockerfile.
#
# The GB10's CPU is Arm; the stage has no RUN, so any host builds it for arm64.
PLATFORM=linux/arm64
TARGET=deepseek-v4-b12x
# eugr/spark-vllm-b12x nightly-20261015, the B12X runner its DeepSeek-V4-Flash recipe launches (see the stage).
BASE=eugr/spark-vllm-b12x@sha256:03a956544e9f9b4b7ba91690469fbe7848bdbef29a7d2e0f5788368467bb3595

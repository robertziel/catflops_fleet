# vLLM build glm53 on nvidia-sm121 (GB10): the pin deploy/images/build.sh reads — KEY=VALUE, one a line, never sourced.
# PLATFORM, TARGET and BASE_ID are the build's own; every other key is a --build-arg of ./Dockerfile.
#
# The GB10's CPU is Arm (lb/vllm_lb/hardware/accelerators/nvidia-sm121.yml platforms); the stage has no RUN, so any
# host builds it for arm64.
PLATFORM=linux/arm64
TARGET=glm53
# tonyd2wild's sm121 v11 GLM-5.3-Flash vLLM, the digest both published 2x DGX Spark runs measured on (see the stage).
BASE=ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6

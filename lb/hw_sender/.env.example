# lb/hw_sender/.env: ONE server's hardware sender (gitignored). Copy this file to .env on that server
# and fill in the lines its COMPOSE_FILE needs. Each server has different ports, names and networks,
# so nothing has a default: compose refuses an unset value and names it. Values are plain KEY=VALUE,
# no quotes, no inline comments. Run compose from lb/hw_sender/.

# ── which files make up this server's sender ──────────────────────────────────────────────────────
# The base, exactly ONE GPU kind, and bridged.yml only where the LB runs on this same server and the
# LAN must not hear the broadcast. ':'-separated, relative to lb/hw_sender/:
#   docker-compose.yml:gpu-amd.yml                  AMD GPU (ROCm in /opt/rocm), broadcast on the LAN
#   docker-compose.yml:gpu-nvidia.yml               every NVIDIA GPU, broadcast on the LAN
#   docker-compose.yml:gpu-nvidia.yml:bridged.yml   every NVIDIA GPU, broadcast on the LB's docker network only
# Uncomment it. Set but EMPTY, compose fails with a cryptic "read lb/hw_sender: is a directory".
# Left commented, compose reads docker-compose.yml alone. That names no GPU kind, and the preflight
# refuses to start.
# COMPOSE_FILE=docker-compose.yml:gpu-<kind>.yml

# ── every server ──────────────────────────────────────────────────────────────────────────────────
# The UDP port each sample is sent to: the LB's LB_HW_PORT (lb/.env of the LB that should draw this
# server; that LB listens on 48291 unless it sets another).
HW_SENDER_PORT=

# Docker's data root on this server (`docker info --format '{{.DockerRootDir}}'`; /var/lib/docker unless the
# daemon moved it). Its containers/ directory is mounted READ-ONLY for the flight recorder's container names and
# images (docker-compose.yml says why not the socket).
HW_SENDER_DOCKER_ROOT=

# ── bridged.yml only ──────────────────────────────────────────────────────────────────────────────
# The name this sender puts on the wire. It must be this server's box `hostname` in the LB's fleet file
# (lb/fleet.yml: boxes.<box>.hostname). Under host networking the container carries
# the server's own hostname and this line is not read.
HW_SENDER_HOSTNAME=
# The docker network the vllm-lb container is attached to (`docker inspect vllm-lb`, Networks). A plain
# `cd lb && docker compose up` names it lb_default.
HW_SENDER_LB_NETWORK=

# Copy to the repo-root .env (gitignored). It is read by dashboard/.env (a symlink to it, for compose
# interpolation) and by the frpc client of power/ (env_file). Set what you run.

# The frps server the frpc clients dial (frpc/, dashboard, power), and its auth token (must
# match frps.toml on the server). Each frpc config reads them as {{ .Envs.FRP_SERVER }} and
# {{ .Envs.FRP_TOKEN }}. Needed only by the frpc clients: unset, those clients cannot reach or log in to
# frps; the services themselves still run.
FRP_SERVER=
FRP_TOKEN=

# dashboard: the vLLM servers to poll, comma-separated URLs, e.g. http://<box>:8000,http://<box2>:8000.
# Required: the dashboard refuses to start without it.
VLLM_SERVERS=

# dashboard: the gateway it shows (as the container reaches it, e.g. http://host.docker.internal:8010 — that
# host:port must then be in the LB's LB_ALLOWED_HOSTS, lb/.env, or the LB answers it 421) and the
# model name its chat panel labels and sends. Both required: the dashboard refuses to start without them, naming
# the one missing — there is no localhost or model-name stand-in.
LB_URL=
CHAT_MODEL=

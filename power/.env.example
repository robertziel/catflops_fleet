# Copy to power/.env (gitignored). Compose reads it for interpolation: the public origin of the page, the
# machines this service may act on, and the dry-run switch. Nothing here is a secret, but the inventory is
# YOUR hardware, so it stays out of git. Every variable below defaults to the REFUSING value when unset.
#
# The public origin of the page (the CSRF check). Empty = every request is refused.
POWER_ORIGINS=https://vllm.example.test
#
# THE NAMES THIS PANEL ANSWERS TO (fleet_power/host_guard.py, the DNS-rebinding guard — the gateway's LB_ALLOWED_HOSTS
# rule): a request's Host must be one of its loopback names at POWER_BIND's port (127.0.0.1:8016, localhost:8016,
# [::1]:8016) or a name here, or it is answered 421. REQUIRED, no default (compose and the service both refuse
# without it): the Host the edge's nginx presents through the tunnel (`proxy_set_header Host $host` = the name alone,
# so no port), comma-separated host[:port]; `loopback` when nothing but this box reaches it. Each distinct Host is
# printed once at first sight ("[host] first request with Host ..."): docker logs vllm-power | grep -F '[host]'
POWER_ALLOWED_HOSTS=vllm.example.test
#
# The machines this service may act on: a JSON array, one object per machine, on ONE line (the single
# quotes keep the JSON literal). Empty = none, so every box is refused, and a malformed value stops the
# service at boot, naming POWER_BOXES.
#   name          the key the page uses for the machine
#   ssh_host      the machine's address on its DIRECT cable from the host this service runs on
#   ssh_port      optional, 22
#   ssh_user      optional, fleet-power (the user install/host-setup.sh creates)
#   in_cluster    true if powering it off drops a cluster it belongs to (the panel then asks first)
#   gpu_clock     true if the panel may cap this machine's GPU clock (needs the clock keys on the box)
#   default_gpu_clock_mhz  optional, needs gpu_clock: one of the caps (2200, 2300) the service keeps on the
#                 GPU and re-applies whenever the box comes back up; absent = the service keeps it released.
#                 Any other value stops the service at boot.
#   wol           null, or { "mac", "iface" (this host's NIC on that cable), "broadcast" (the cable's /30 broadcast) }
#   power_on_note, consequence   the panel's own words for the machine
#
# Example (documentation addresses, locally administered MACs):
POWER_BOXES='[{"name":"box-a","ssh_host":"192.0.2.2","in_cluster":true,"gpu_clock":true,"default_gpu_clock_mhz":2200,"wol":{"mac":"02:00:00:00:00:02","iface":"eth-box-a","broadcast":"192.0.2.3"},"power_on_note":"Wake-on-LAN from the host over the direct cable.","consequence":"The model cluster goes down."},{"name":"box-c","ssh_host":"127.0.0.1","power_on_note":"Power it on with its plug: this page runs on it.","consequence":"This page and every service on the host go down."}]'
#
# DRY RUN is the default: the forced command powers nothing off. Going live is a decision: set it to 0.
POWER_DRY_RUN=1
#
# Read by the code (fleet_power/__main__.py); the compose file sets the container paths below.
# POWER_BIND=127.0.0.1:8016                  # the listener; never a public address
# POWER_LB_STATUS=http://127.0.0.1:8010/lb/status   # read-only: the cluster state, never a control call
# POWER_GATE_SECRET_FILE=/run/secrets/gate   # the secret the front proxy sends as X-Power-Gate; missing = refuse all
# POWER_KEY=/keys/fleet-power                # ssh key for the power actions
# POWER_DRY_KEY=/keys/fleet-power-dryrun     # ssh key for the dry-run forced command
# POWER_KNOWN_HOSTS=/keys/known_hosts        # pinned host keys of the boxes
# POWER_CLOCK_LIMIT_KEY=/keys/fleet-clock-limit           # one key per clock action (the MHz stay on the box)
# POWER_CLOCK_LIMIT_2300_KEY=/keys/fleet-clock-limit-2300
# POWER_CLOCK_RELEASE_KEY=/keys/fleet-clock-release
# POWER_CLOCK_DRY_KEY=/keys/fleet-clock-dryrun
# POWER_AUDIT=/audit/audit.jsonl             # the JSON-lines audit log of every action
#
# The tunnel client (vllm-power-frpc) reads the REPO-ROOT .env instead (FRP_SERVER, FRP_TOKEN).
